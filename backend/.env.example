# ──────────────────────────────────────────
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Database
DATABASE_URL=postgresql://dashmet:dashmet@postgres:5432/dashmet

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encryption key for platform tokens — must be 32 url-safe base64 bytes
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-with-fernet

# TikTok OAuth — get from TikTok for Business Developer Portal
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/connections/tiktok/oauth/callback
FRONTEND_URL=http://localhost:3000

# Google Ads — developer token from Google Ads API Center (in an MCC account),
# OAuth client from Google Cloud Console (enable "Google Ads API"),
# login_customer_id = your MCC/manager customer id (10 digits, no dashes).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/oauth/callback

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
